<!DOCTYPE html>
<html lang="en" data-version="@App.AppVersion">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="apple-touch-icon" href="~/favicon-180x180.png" />
    <script>
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('theme'); } catch (e) { }
            document.documentElement.classList.toggle('dark', stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css?v=@App.AppVersion" />
    <meta name="keywords" content="silvestre" />
</head>
<body>
    <nav class="site-nav">
        <div class="wrap flex items-center gap-5 h-[60px]">
            <a class="font-mono font-medium text-[15px]" href="/">joão<b class="text-(--accent)">.</b>silvestre</a>
            <div class="hidden md:flex gap-1 ml-auto">
                <a class="nav-link" href="/#about">About</a>
                <a class="nav-link" href="/ai">AI</a>
                <a class="nav-link" href="/#projects">Projects</a>
                <a class="nav-link" href="/#writing">Writing</a>
                <a class="nav-link" href="@SiteLinks.PsyRoot" target="_blank" rel="noopener">WISC-III ↗</a>
                <a class="nav-link" href="/#contact">Contact</a>
            </div>
            <div class="flex gap-2 ml-auto md:ml-0">
                <button type="button" class="pill" onclick="Silvestre.toggleDarkMode()" aria-label="Toggle theme">◐ theme</button>
                <button type="button" class="pill navbar-burger md:hidden" aria-controls="main-nav" aria-expanded="false">
                    <span class="sr-only">Open main menu</span>
                    <svg id="main-nav-button-closed" class="block h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg id="main-nav-button-open" class="hidden h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>
        <div id="main-nav" class="hidden md:hidden border-t border-(--line)">
            <div class="wrap py-2 flex flex-col">
                <a class="nav-link text-base!" href="/#about">About</a>
                <a class="nav-link text-base!" href="/ai">AI</a>
                <a class="nav-link text-base!" href="/#projects">Projects</a>
                <a class="nav-link text-base!" href="/#writing">Writing</a>
                <a class="nav-link text-base!" href="@SiteLinks.PsyRoot" target="_blank" rel="noopener">WISC-III ↗</a>
                <a class="nav-link text-base!" href="/#contact">Contact</a>
            </div>
        </div>
    </nav>

    <main class="wrap">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="wrap flex flex-wrap justify-between gap-3">
            <span>© @DateTime.Now.Year João Silvestre</span>
            <span class="flex gap-4">
                <a href="@SiteLinks.GitHub" rel="noopener">GitHub</a>
                <a href="@SiteLinks.LinkedIn" rel="noopener">LinkedIn</a>
                <span class="font-mono">v@(App.AppVersion)</span>
            </span>
        </div>
    </footer>

    <script src="~/js/site.js?v=@App.AppVersion" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
