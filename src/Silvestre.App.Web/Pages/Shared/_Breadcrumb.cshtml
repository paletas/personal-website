@model IReadOnlyList<BreadcrumbItem>
@{
    var site = Content.Get(CultureInfo.CurrentUICulture);
}
<nav class="crumb" aria-label="@site.A11y.Breadcrumb"><ol>
    @for (var i = 0; i < Model.Count; i++)
    {
        var item = Model[i];
        <li>
            @if (i > 0)
            {
                <span aria-hidden="true">/ </span>
            }
            @if (i == Model.Count - 1)
            {
                <span aria-current="page">@item.Text</span>
            }
            else if (!string.IsNullOrEmpty(item.Href))
            {
                <a href="@item.Href">@item.Text</a>
            }
            else
            {
                @item.Text
            }
        </li>
    }
</ol></nav>
