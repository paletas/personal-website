@page "/projects/{slug:regex(^[a-z0-9-]+$)}"
@model Silvestre.App.Web.Pages.Projects.DetailModel
@{
    var site = Content.Get(CultureInfo.CurrentUICulture);
    var prefix = SiteContentProvider.Prefix(CultureInfo.CurrentUICulture);
    ViewData["Title"] = Model.Entry.Title + " | " + site.Meta.Title;
    ViewData["Description"] = Model.Entry.Tagline;
    var crumbs = new BreadcrumbItem[] { new BreadcrumbItem(site.A11y.Home, string.IsNullOrEmpty(prefix) ? "/" : prefix), new BreadcrumbItem(site.ProjectsPage.Crumb, prefix + "/projects"), new BreadcrumbItem(Model.Entry.Title, null) };
    var isWorkflow = Model.Entry.Kind == "workflow";
    string StatusText(string status) => status switch
    {
        "active" => site.ProjectsPage.StatusActive,
        "maintenance" => site.ProjectsPage.StatusMaintenance,
        "dormant" => site.ProjectsPage.StatusDormant,
        _ => status
    };
}

<div class="page-head">
    <partial name="_Breadcrumb" model="crumbs" />
    @if (!isWorkflow && Model.Facts is not null)
    {
        <div class="meta" style="margin-top:22px">@site.ProjectsPage.StatusLabel: @StatusText(Model.Facts.Status) · @site.ProjectsPage.StackLabel: @string.Join(", ", Model.Facts.Stack) · @site.ProjectsPage.LastActiveLabel: @Model.Facts.LastActive</div>
    }
    <h1 class="display !text-[clamp(30px,5vw,52px)] mt-2 mb-2 max-w-[24ch]">@Model.Entry.Title</h1>
</div>

@if (isWorkflow)
{
    <p class="mb-4"><a class="underline" href="@(prefix + "/ai")">@site.ProjectsPage.AiLink</a></p>
}

<article class="prose dark:prose-invert max-w-none">@Html.Raw(Model.Entry.Html)</article>

<div class="my-10"><a class="btn" href="@(prefix + "/projects")">← @site.ProjectsPage.Back</a></div>
