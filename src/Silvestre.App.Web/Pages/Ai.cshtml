@page "/ai"
@model Silvestre.App.Web.Pages.AiModel
@inject Silvestre.App.Web.Models.AiContent AiDoc
@{
    var site = Content.Get(CultureInfo.CurrentUICulture);
    var prefix = SiteContentProvider.Prefix(CultureInfo.CurrentUICulture);
    ViewData["Title"] = site.Meta.AiTitle;
    ViewData["Description"] = site.Meta.AiDescription;
}
@{
    var doc = AiDoc.Get(CultureInfo.CurrentUICulture);
    var isEn = !SiteContentProvider.IsPt(CultureInfo.CurrentUICulture);
    var loop = doc.Section("loop");
    var prototype = doc.Section("prototype");
    var behaviour = doc.Section("behaviour");
    var unbounded = doc.Section("unbounded");
    var benefits = doc.Section("benefits");
    var hood = doc.Section("under-the-hood");
    var practice = doc.Section("in-practice");
    var contact = doc.Section("contact");
    var crumbs = new BreadcrumbItem[] { new BreadcrumbItem(site.A11y.Home, string.IsNullOrEmpty(prefix) ? "/" : prefix), new BreadcrumbItem(site.Nav.Ai, null) };
}

<div class="page-head">
    <partial name="_Breadcrumb" model="crumbs" />
    <h1 class="display !text-[clamp(36px,6vw,64px)] max-w-[20ch] mt-4 mb-4">@Html.Raw(doc.Head.HeadingHtml)</h1>
    <div class="lead">@Html.Raw(doc.Head.IntroHtml)</div>
</div>

<section id="loop" class="py-7">
    <div class="label">@loop.Label</div>
    <div class="card span-12">
        <div class="steps">
            @for (var i = 0; i < loop.Items.Count; i++)
            {
                var step = loop.Items[i];
                var hl = i == 2;
                <div class="step@(hl ? " step-hl" : "")">
                    <div class="n">@((i + 1).ToString("00"))</div>
                    <div><h2 class="text-[19px] mb-1.5">@step.Title<span class="who@(hl ? " who-me" : "")">@step.Who</span></h2><p class="muted">@Html.Raw(step.BodyHtml)</p></div>
                </div>
            }
        </div>
    </div>
</section>

<section id="prototype" class="py-7">
    <div class="label">@prototype.Label</div>
    <div class="card">
        <div class="split items-center">
            <div>
                <h2 class="text-[26px] tracking-tight mb-2">@Html.Raw(prototype.HeadingHtml)</h2>
                <div class="muted">@Html.Raw(prototype.IntroHtml)</div>
            </div>
            <div class="scn" role="group" aria-label="@site.A11y.Scenario">@Html.Raw(AiContent.HighlightScenario(prototype.Code))</div>
        </div>
    </div>
</section>

<section id="behaviour" class="py-7">
    <div class="label">@behaviour.Label</div>
    <div class="split">
        <div class="card">
            <h2 class="text-[26px] tracking-tight mb-2">@Html.Raw(behaviour.HeadingHtml)</h2>
            <div class="muted [&_p+p]:mt-3">@Html.Raw(behaviour.IntroHtml)</div>
        </div>
        <div class="scn" role="group" aria-label="@site.A11y.Scenario">@Html.Raw(AiContent.HighlightScenario(behaviour.Code))</div>
    </div>
</section>

<section id="unbounded" class="py-7">
    <div class="label">@unbounded.Label</div>
    <div class="card">
        <div class="big">@Html.Raw(unbounded.HeadingHtml)</div>
        <div class="muted mt-4 max-w-[70ch]">@Html.Raw(unbounded.IntroHtml)</div>
        <div class="tags"><span class="tag">C#</span><span class="tag">Go</span><span class="tag">TypeScript</span><span class="tag">Python</span><span class="tag">Rust</span><span class="tag">SQL</span><span class="tag">Bash</span><span class="tag tag-hl">...whatever it needs</span></div>
    </div>
</section>

<section id="benefits" class="py-7">
    <div class="label">@benefits.Label</div>
    <div class="three">
        @foreach (var item in benefits.Items)
        {
            <div class="card"><h3 class="text-[19px] mb-1.5">@item.Title</h3><p class="muted">@Html.Raw(item.BodyHtml)</p></div>
        }
    </div>
</section>

<section id="under-the-hood" class="py-7">
    <div class="label">@hood.Label</div>
    <div class="card">
        <div class="muted max-w-[60ch]">@Html.Raw(hood.IntroHtml)</div>
        <div class="tags"><span class="tag tag-hl">Claude Code</span><span class="tag tag-hl">Subagents</span><span class="tag">Opus &amp; Sonnet</span><span class="tag">Local models</span><span class="tag">Git worktrees</span></div>
        <p class="mt-3"><a class="underline" href="@(prefix + "/projects/workflow")">@site.ProjectsPage.WorkflowLink</a></p>
    </div>
</section>

<section id="in-practice" class="py-7">
    <div class="label">@practice.Label</div>
    <div class="card">
        <h2 class="text-[26px] tracking-tight mb-2">@Html.Raw(practice.HeadingHtml)</h2>
        <div class="muted">@Html.Raw(practice.IntroHtml)</div>
    </div>
</section>

<section id="contact" class="contact">
    <h2 class="text-[clamp(30px,5vw,48px)] tracking-tight">@Html.Raw(contact.HeadingHtml)</h2>
    <div class="muted mt-2.5 mb-6">@Html.Raw(contact.IntroHtml)</div>
    <div class="flex justify-center"><a class="btn btn-primary" href="@(prefix + "/#contact")">@contact.Cta</a></div>
</section>
