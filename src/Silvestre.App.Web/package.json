{
  "name": "silvestre.website",
  "version": "1.0.0",
  "devDependencies": {
    "eslint": "10.11.0",
    "tailwindcss": "4.1.18",
    "browserslist": "4.29.3",
    "gulp": "5.0.1"
  },
  "scripts": {
    "prepare": "npx browserslist@latest --update-db && npx tailwindcss -i ./wwwroot/css/tailwind.css -o ./wwwroot/css/site.css"
  },
  "-vs-binding": {
    "BeforeBuild": [
      "prepare"
    ]
  }
}
