{
  "name": "silvestre.website",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "charts.css": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./wwwroot/css/tailwind.css -o ./wwwroot/css/site.css --minify && npm run vendor",
    "watch:css": "tailwindcss -i ./wwwroot/css/tailwind.css -o ./wwwroot/css/site.css --watch",
    "vendor": "node -e \"const fs=require('fs');fs.mkdirSync('wwwroot/lib',{recursive:true});fs.copyFileSync('node_modules/charts.css/dist/charts.min.css','wwwroot/lib/charts.min.css')\""
  }
}
